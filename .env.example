# Copy to .env (git-ignored) and fill in. Spring Boot and docker compose both read it.

# --- PostgreSQL + pgvector (docker compose) ---
DB_NAME=ragdb
DB_USER=rag
DB_PASSWORD=rag
DB_PORT=5432

# --- LLM / embeddings (Spring AI, OpenAI-compatible) ---
OPENAI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.openai.com
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# MUST match the embedding model's output size (text-embedding-3-small = 1536).
# If you change the embedding model, change this and recreate the vector table.
EMBEDDING_DIMENSIONS=1536

# --- JWT (required) ---
# Must contain a Base64-encoded cryptographically random secret.
# Generate with: openssl rand -base64 48
# The application Base64-decodes this secret before using it as the HMAC-SHA signing key.
# Decoded secret must be at least 32 bytes (256 bits); 48 bytes (384 bits) is recommended.
JWT_SECRET=
